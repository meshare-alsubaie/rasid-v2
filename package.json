{
  "name": "rasid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RASID (راصد) - tracker for Saudi cooperative-training application windows",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run gates",
    "validate": "tsx scripts/validate.ts",
    "collect": "tsx scripts/collect.ts",
    "verify-leads": "tsx scripts/verify-leads.ts",
    "add-lead": "tsx scripts/add-lead.ts",
    "discover": "tsx scripts/discover-links.ts",
    "sitemaps": "tsx scripts/watch-sitemaps.ts",
    "merges": "tsx scripts/propose-merges.ts",
    "audit:domains": "tsx scripts/audit-domains.ts",
    "diff-source": "tsx scripts/diff-source.ts",
    "test:classifier": "tsx scripts/test-classifier.ts",
    "icons": "tsx scripts/make-icons.ts",
    "notify": "tsx scripts/notify.ts",
    "test:notify": "tsx scripts/test-notify.ts",
    "test:lifecycle": "tsx scripts/test-lifecycle.ts",
    "test:sitemap": "tsx scripts/test-sitemap.ts",
    "test:hijri": "tsx scripts/test-hijri.ts",
    "test:extract": "tsx scripts/test-extract.ts",
    "test:benchmark": "tsx scripts/test-benchmark.ts",
    "test:faults": "tsx scripts/test-faults.ts",
    "test:scripts": "tsx scripts/test-scripts.ts",
    "test:longrun": "tsx scripts/test-longrun.ts",
    "test:gates": "tsx scripts/test-gates.ts",
    "test:costfilter": "tsx scripts/test-costfilter.ts",
    "test:triage": "tsx scripts/test-triage.ts",
    "test:schedule": "tsx scripts/test-schedule.ts",
    "watch": "tsx scripts/watch.ts",
    "build:benchmark": "tsx scripts/build-benchmark.ts",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "audit:privacy": "tsx scripts/audit-privacy.ts",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm run validate",
    "test:relevance": "tsx scripts/test-relevance.ts",
    "test:toast": "tsx scripts/test-toast.ts",
    "requeue": "tsx scripts/requeue.ts",
    "test:mobile": "tsx scripts/test-mobile.ts",
    "vapid:new": "tsx scripts/vapid-new.ts",
    "test:records": "tsx scripts/test-records.ts",
    "test:copied": "tsx scripts/test-copied.ts",
    "test:push": "tsx scripts/test-push.ts",
    "test:redact": "tsx scripts/test-redact.ts",
    "test:arabic": "tsx scripts/test-arabic.ts",
    "status": "tsx scripts/status.ts",
    "gates": "npm run typecheck && npm run validate && npm run audit:privacy && npm run audit:domains && npm run test:records && npm run test:copied && npm run test:redact && npm run test:push && npm run test:arabic && npm run test:relevance && npm run test:hijri && npm run test:scripts && npm run test:extract && npm run test:costfilter && npm run test:schedule && npm run test:sitemap && npm run test:lifecycle && npm run test:notify && npm run test:benchmark && npm run test:faults && npm run test:longrun",
    "gates:local": "npm run test:triage && npm run test:classifier && npm run test:toast"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.1",
    "linkedom": "^0.18.13",
    "p-limit": "^7.3.1",
    "robots-parser": "^3.0.1",
    "undici": "^8.10.0",
    "web-push": "^3.6.7"
  }
}
