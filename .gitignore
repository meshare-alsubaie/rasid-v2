node_modules/
dist/
.cache/
.env
.env.*

# The student profile. The only file here that describes a person, and the
# repository is public. See .profile.example.
.profile.local

# The contact address put in the User-Agent, so site owners can reach a human.
# A personal email, and this repository is public.
.contact.local
*.log
# A data file mid-write. Present only while a round is writing, and never
# committed: a half-written dataset is the one thing worse than a late one.
data/*.json.tmp
# Per-machine tool settings, rewritten by the editor as permissions change.
# Committing it means every approval on this laptop travels to the repository.
.claude/settings.local.json
.DS_Store
Thumbs.db
scheduled-run.log

# Per-machine watcher state: which source is due when, and the list handed to
# the current cycle. Rebuilt on first run; committing it would push one
# machine's timing into everyone else's clone.
.rasid/
watch.log

# Measurement output from the probes. Regenerated by running them, and large.
scripts/probe/results/

# The headless browser, installed inside the repository so a scheduled task can
# reach it. See the note in scripts/watch-run.ps1 for why it does not live in
# the user profile like everything else.
.playwright/
